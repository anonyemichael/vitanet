# VitaNet API Configuration (server side; never put keys in the app)
# The assistant is the VitaNet model (OpenAI-compatible server, e.g. vLLM). Gemini / OpenRouter are no longer used.
AI_BASE_URL=
AI_MODEL=vitanet-27b
AI_API_KEY=
# Web search for the assistant's web_search tool (Tavily, else Google Programmable Search)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
TAVILY_API_KEY=
