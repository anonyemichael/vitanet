rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Allow access to the conversations subcollection
      match /conversations/{conversationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Shared, curated content read by every signed-in user. Writes stay
    // closed: content should be managed from the console / backend, not by
    // app clients (the app's cache writes simply fail and are ignored).
    match /first_aid_guides/{docId} {
      allow read: if request.auth != null;
    }
    match /dynamic_medicines/{docId} {
      allow read: if request.auth != null;
    }
    match /dynamic_videos/{docId} {
      allow read: if request.auth != null;
    }
    match /dynamic_articles/{docId} {
      allow read: if request.auth != null;
    }
  }
}
