{
  "mcpServers": {
    "21st-magic-ui": {
      "command": "npx",
      "args": ["-y", "@21st-dev/magic-mcp"]
    },
    "figma-developer-mcp": {
      "command": "npx",
      "args": ["-y", "figma-developer-mcp", "--stdio"],
      "env": {
        "FIGMA_API_KEY": "YOUR_FIGMA_API_KEY_HERE"
      }
    },
    "shadcn-ui-server": {
      "command": "npx",
      "args": ["-y", "@jpisnice/shadcn-ui-mcp-server"]
    }
  }
}
