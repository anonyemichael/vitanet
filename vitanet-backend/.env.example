APP_NAME=VitaNet API
ENVIRONMENT=development

DATABASE_URL=your_database_url_here
SECRET_KEY=your_secret_key_here
OPENAI_API_KEY=
# ---- The VitaNet model (OpenAI-compatible, e.g. vLLM). Empty AI_BASE_URL = assistant offline (safety warnings still work):
# AI_BASE_URL=http://<model-server>:8000/v1
# AI_MODEL=vitanet-27b
# AI_API_KEY=
# ---- Hospital-portal model (5 JSON tasks). Leave empty to use the rule-based answers only.
# PORTAL_AI_URL=http://<model-server>:8000/v1
# PORTAL_AI_MODEL=vitanet-27b
# PORTAL_AI_KEY=
# PORTAL_AI_TIMEOUT_S=20
# ---- Tools: web search (Tavily, else Google CSE) and SMS (Africa's Talking). Keys only here, never in code.
# TAVILY_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_CSE_ID=
# AT_USERNAME=sandbox
# AT_API_KEY=
# AT_SHORTCODE=
# SMS_WEBHOOK_TOKEN=      # long random string; callback URL = https://<server>/sms/inbound?token=<it>
# SMS_HASH_SECRET=        # long random string; phone numbers are stored only as a hash
# SMS_MAX_PER_HOUR=15
# SMS_MAX_SEGMENTS=3
# ---- Health alerts: an urgent alert nobody answers is sent to the care circle (SMS, else email) after this.
# ALERT_ESCALATION_MINUTES=10
# PUBLIC_BASE_URL=https://<your server>     # links in care-circle invite emails
# ---- Health videos: free key from Google Cloud with "YouTube Data API v3" enabled (server only, never in the app)
# YOUTUBE_API_KEY=
# ---- Health library photos: free key from pexels.com/api (server only)
# PEXELS_API_KEY=
