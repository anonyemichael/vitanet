# ==============================================================================
# VitaNet — Unified .gitignore
# ==============================================================================

# ─── Environment & Secrets ────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── OS Files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ─── IDE / Editor ─────────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.swp
*.swo
*~
.atom/
.history

# ─── Flutter / Dart ───────────────────────────────────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
**/doc/api/
**/ios/Flutter/.last_build_id
**/ios/Pods/

# Symbolication & Obfuscation
app.*.symbols
app.*.map.json

# Android Studio build artifacts
/android/app/debug
/android/app/profile
/android/app/release

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
*.egg
.venv/
venv/
env/

# ─── ML / Data Artifacts ─────────────────────────────────────────────────────
# Large model & dataset files — track with Git LFS instead
ml-service/notebooks/*.pkl
ml-service/data/*.csv
*.h5
*.hdf5
*.onnx

# Jupyter
.ipynb_checkpoints/

# ─── Node.js ──────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log*

# ─── Miscellaneous ────────────────────────────────────────────────────────────
*.class
*.log
*.bak
migrate_working_dir/
.svn/
.swiftpm/
.build/
.buildlog/
/coverage/
run_web.bat
run_web.ps1
# Widget Preview related
.widget_preview/
.firebase/
*.db
.agent/
.agents/
